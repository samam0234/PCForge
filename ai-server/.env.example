AI_SERVER_PORT=8000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3

# 네이버 쇼핑 검색 API (https://developers.naver.com → 애플리케이션 등록 → 검색). 값은 커밋하지 않는다.
